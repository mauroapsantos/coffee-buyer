#!/bin/bash
# Run a command inside the Node 22 container (no Node needed on the host).
# Usage: scripts/n pnpm install | scripts/n pnpm test | scripts/n pnpm cli stats
cd "$(dirname "$0")/.." || exit 1
NET=$(docker network ls --format '{{.Name}}' | grep -m1 '^coffee-buyer_default$')
docker image inspect coffee-buyer-dev >/dev/null 2>&1 || docker build -q --target dev -t coffee-buyer-dev . >/dev/null
exec docker run --rm -i $([ -t 0 ] && echo -t) \
  --user "$(id -u):$(id -g)" -e HOME=/app/.home -e COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
  ${NET:+--network "$NET"} --env-file <(cat .env 2>/dev/null) \
  -v "$PWD":/app -w /app ${PORTS:+-p "$PORTS"} \
  coffee-buyer-dev bash -c 'mkdir -p $HOME/bin && corepack enable --install-directory $HOME/bin >/dev/null && PATH=$HOME/bin:$PATH && exec "$@"' -- "$@"
